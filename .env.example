# Copy thành .env rồi dán token của bạn vào. KHÔNG commit file .env.
# Long-lived token của Threads app (cần quyền threads_basic + threads_keyword_search).
THREADS_ACCESS_TOKEN=

# Google Gemini (có gói miễn phí): lấy key ở https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI (trả phí theo lượt dùng)
OPENAI_API_KEY=
